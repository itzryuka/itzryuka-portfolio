@{
    ViewData["Title"] = "Portfolio - Quang Lùn";
}

<style>
    /* Bảng màu và CSS dùng riêng cho trang này */
    :root {
        --bg-main: #0d1117;       /* Nền xanh đen sâu */
        --card-bg: #161b22;       /* Nền thẻ nhạt hơn chút */
        --card-border: #30363d;   /* Viền thẻ mỏng */
        --text-main: #f0f6fc;
        --text-muted: #8b949e;
        --accent-color: #58a6ff;  /* Xanh dương làm điểm nhấn */
        --gradient-bar: linear-gradient(90deg, #3fb950 0%, #2ea043 50%, #58a6ff 100%);
    }
    /* Hiệu ứng trượt mượt và cách lề */
    html {
        scroll-behavior: smooth !important; /* Lệnh này giúp trượt từ từ (smooth) */
        scroll-padding-top: 80px; /* Khúc này cực quan trọng: Báo cho web biết phải dừng lại cách đỉnh 80px để nhường chỗ cho Navbar */
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-main);
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        color: #f0f6fc !important;
        padding-top: 70px; /* Đẩy toàn bộ trang xuống 70px để cái Avatar to đùng ở trang chủ không bị Navbar đè lên */
    }
    
    /* Ép màu chữ trắng sáng cho toàn trang */
    body, .container, h1, h2, h3, h4, h5, h6, p, span {
        color: #f0f6fc !important;
    }
    
    /* "Độ" lại class text-muted của Bootstrap cho nó thành màu xám sáng (đọc được trên nền đen) */
    .text-muted {
        color: #8b949e !important; 
    }

    /* Viền của mấy cái thẻ (Card) cũng cho nó sáng lên 1 chút xíu */
    .b-card {
        border-color: #30363d !important;
    }

    /* Định dạng chung cho các Thẻ (Card) */
    .b-card {
        background-color: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: 24px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .b-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 2rem;
        color: var(--text-main);
    }

    /* Các nút bấm */
    .btn-gradient {
        background: linear-gradient(135deg, #a8c0ff 0%, #3f2b96 100%);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 24px;
        font-weight: 600;
    }
    .btn-outline-custom {
        background: transparent;
        border: 1px solid var(--card-border);
        color: var(--text-main);
        border-radius: 8px;
        padding: 10px 24px;
    }

    /* Chỉnh thanh Progress Bar */
    .custom-progress {
        height: 6px;
        background-color: #21262d;
        border-radius: 10px;
        overflow: hidden;
        margin-top: 8px;
    }
    .custom-progress-bar {
        height: 100%;
        background: var(--gradient-bar);
        border-radius: 10px;
    }

    /* Nút chấm xanh Online */
    .status-dot {
        width: 8px; height: 8px;
        background-color: #3fb950;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 8px #3fb950;
    }
</style>

<div class="container py-5">

    <!-- ==========================================
         PHẦN 1: HOME (HERO SECTION)
    =========================================== -->
    <section id="home" class="min-vh-100 d-flex align-items-center pt-5">
